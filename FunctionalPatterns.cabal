cabal-version: 3.0
name:          FunctionalPatterns
version:       0.1.0.0
maintainer:    daniel.kroeni@fhnw.ch
author:        Daniel Kröni
build-type:    Simple

executable validation
    main-is:          Validation/Main.hs
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
    build-depends:
        base >=4.17 && <5,
        scotty ==0.30,
        aeson,
        text,
        http-types

test-suite option
    type:             exitcode-stdio-1.0
    main-is:          Data/Tests.hs
    other-modules:    Data.Option
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base >=4.17 && <5,
        hspec ==2.11.17,
        hspec-contrib,
        QuickCheck,
        HUnit

test-suite reader
    type:             exitcode-stdio-1.0
    main-is:          Reader/Tests.hs
    other-modules:    Reader.Example
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base >=4.17 && <5,
        hspec ==2.11.17,
        hspec-contrib,
        QuickCheck,
        HUnit

test-suite imp
    type:             exitcode-stdio-1.0
    main-is:          Lang/Tests.hs
    other-modules:    Lang.Imp
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:
        base >=4.17 && <5,
        hspec ==2.11.17,
        containers,
        hspec-contrib,
        QuickCheck,
        HUnit
